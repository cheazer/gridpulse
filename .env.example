# Copy to .env and adjust. Never commit .env.
# All data sources used in Phase 1 are public and need no API keys.

# TimescaleDB (local dev only; production values come from a secret store)
POSTGRES_DB=gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me-locally
# Host port; change if you already run PostgreSQL on 5432
TIMESCALE_PORT=5432
# Read-only login for the forecasting service (created by the db-users job)
FORECAST_DB_PASSWORD=change-me-locally
# MLflow's own login and database (created by the db-users job). It goes into a connection URI,
# so use URL-safe characters only: letters, digits, '-' and '_'.
MLFLOW_DB_PASSWORD=change-me-locally

# MLflow tracking server; the forecasting CLI logs backtests here when this is set
MLFLOW_TRACKING_URI=http://localhost:5000

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
