# Copy to .env and adjust. Never commit .env.
# All data sources used in Phase 1 are public and need no API keys.

# TimescaleDB (local dev only; production values come from a secret store)
POSTGRES_DB=gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me-locally

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
