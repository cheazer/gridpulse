root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,kts,gradle}]
indent_size = 4

# LF like everything else: .gitattributes stores text as LF, so CRLF here would make `dotnet format` fail in CI.
[*.{cs,csproj,razor,props,slnx}]
indent_size = 4

[*.py]
indent_size = 4

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
